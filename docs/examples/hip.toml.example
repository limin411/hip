# Example hip.toml (copy ideas into ~/.hip/config/hip.toml or project .hip/hip.toml).
# DO NOT put real API keys here. LLM keys live in ~/.hip/config/auth.json (0600).
#
# Global config:  ~/.hip/config/hip.toml
# Project override: <repo>/.hip/hip.toml
# Some sections (acp, agentLoop, window, …) are wholesale-replaced by
# the project file when present — they are not deep-merged field-by-field.

version = 1

# ── Window & tray (Settings → General → Window & background) ───────────────
# Defaults when omitted: closeAction = "quit", trayEnabled = false
[window]
closeAction = "hide"   # hide | quit | ask
trayEnabled = true
# launchAtLogin = false
# startHiddenOnLogin = true
# notifyOnAgentComplete = false

# ── ACP host policy (external primary agents only) ─────────────────────────
# Resolved defaults: fsBridge = true, forwardMcp = false, fsReadMaxBytes = 2000000
[acp]
fsBridge = true
forwardMcp = false          # keep false unless you trust the external agent with MCP env/headers
# forwardHipKeys = false    # opt-in: inject hip provider keys into ACP spawn env
fsReadMaxBytes = 2000000

# ── Agent loop budgets (optional) ──────────────────────────────────────────
# [agentLoop]
# maxSteps = 800
# childMaxSteps = 25
# exploreChildMaxSteps = 40
# maxDepth = 3
# doomLoopStrategy = "nudge_then_pause"  # nudge_then_pause | pause_immediately | auto_continue
# idleTimeoutMs = 180000

# ── Context / compaction (optional) ────────────────────────────────────────
# [context]
# autoCompactPercent = 85
# subagentCompactPercent = 70
# targetKeepPercent = 50
# prefireLeadPercent = 10
# twoPass = true
# toolOutputMaxBytes = 40960

# ── Recycle bin retention ──────────────────────────────────────────────────
# [trash]
# retentionDays = 7

# ── Network proxy (Settings → General) ──────────────────────────────────────
# When enabled, injected as HTTP_PROXY / HTTPS_PROXY / ALL_PROXY / NO_PROXY
# for the sidecar (agent web tools).
# [proxy]
# enabled = true
# http = "http://127.0.0.1:7890"
# https = "http://127.0.0.1:7890"
# # all = "http://127.0.0.1:7890"
# no_proxy = "localhost,127.0.0.1,::1"

# ── Version checks (Settings → General → Version & updates) ─────────────
# Opt-in: default autoCheck=false when omitted — no GitHub traffic until
# the user turns this on or clicks “Check for updates”.
# ON = check GitHub Releases every 24h and notify; never auto-download.
# [updates]
# autoCheck = false

# ── Providers (non-secret) ─────────────────────────────────────────────────
# API keys still go in auth.json — do not use apiKey in hip.toml (ignored for BYOK).
# [[providers]]
# id = "openai"
# name = "OpenAI"
# baseUrl = "https://api.openai.com/v1"
# enabled = true
# # apiKind = "openai"   # or "anthropic" for Messages-compatible gateways

# [activeModel]
# providerID = "openai"
# modelID = "gpt-4o"

# ── Skills enable map (missing id ⇒ enabled) ───────────────────────────────
# [[skills]]
# id = "my-skill"
# enabled = true

# ── MCP servers ────────────────────────────────────────────────────────────
# User/project entries win over plugin MCP with the same id.
# enabled = false claims the id as a veto (plugins cannot fill it).
# allowDuplicate = true keeps this server even if another shares the same
# capability fingerprint (e.g. same npm package). Default false.
# User/project entries win over plugin MCP; enabled = false claims the id as a veto.
# [[mcpServers]]
# id = "chrome-devtools"
# name = "Chrome DevTools"
# transport = "stdio"
# command = "npx"
# args = ["-y", "chrome-devtools-mcp@latest"]
# enabled = true
# # allowDuplicate = false
