{
  "schemaVersion": 1,
  "id": "bytebase-orch",
  "name": "Bytebase L3 orchestration pack",
  "description": "Plan flow, delegation, HITL resume.",
  "defaults": {
    "workspace": {
      "strategy": "worktree",
