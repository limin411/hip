{
  "name": "hip",
  "private": true,
  "version": "1.0.3",
  "description": "Desktop AI workbench (Tauri shell + React UI + Node sidecar)",
  "license": "MIT",
  "author": "ljm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limin411/hip.git"
  },
  "homepage": "https://github.com/limin411/hip#readme",
  "bugs": {
    "url": "https://github.com/limin411/hip/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "desktop",
    "tauri",
    "langgraph",
    "coding-agent",
    "workbench"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "yarn@1.22.22",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecar:dev": "yarn workspace @hip/sidecar dev",
    "sidecar:dev-bin": "node scripts/make-sidecar-dev-bin.js",
    "sidecar:build": "yarn workspace @hip/sidecar build",
    "sidecar:prod-bin": "node scripts/make-sidecar-prod-bin.js",
    "package:macos": "bash scripts/package-macos.sh",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "release:macos": "bash scripts/package-macos.sh",
    "release:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "type-check": "tsc --noEmit",
    "fonts:fetch": "node scripts/fetch-nerd-font.mjs",
    "check:visual-dialects": "node scripts/check-visual-dialects.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:e2e:smoke": "E2E_GREP=@smoke wdio run wdio.conf.ts",
    "test:e2e:gate": "HIP_VOICE_MOCK=1 E2E_GREP='@smoke|@core|@harness|@memory|@panel|@settings|@voice' wdio run wdio.conf.ts",
    "test:e2e:full": "HIP_VOICE_MOCK=1 E2E_GREP=@live E2E_INVERT=1 wdio run wdio.conf.ts",
    "test:e2e:live": "E2E_LIVE_LLM=1 E2E_GREP=@live wdio run wdio.conf.ts",
    "test:e2e:eval": "E2E_LIVE_LLM=1 E2E_GREP=@eval wdio run wdio.conf.ts",
    "test:e2e:eval-smoke": "E2E_GREP='@eval @smoke' wdio run wdio.conf.ts",
    "test:e2e:eval-hard": "E2E_LIVE_LLM=1 E2E_GREP='@eval @hard' wdio run wdio.conf.ts",
    "test:e2e:eval-orch": "E2E_LIVE_LLM=1 E2E_GREP='@eval @orch' wdio run wdio.conf.ts",
    "test:e2e:eval-adv": "E2E_LIVE_LLM=1 E2E_GREP='@eval @adv' wdio run wdio.conf.ts",
    "test:e2e:eval-mini": "E2E_LIVE_LLM=1 E2E_GREP='@eval @mini' wdio run wdio.conf.ts",
    "test:e2e:eval-msm": "E2E_LIVE_LLM=1 E2E_GREP='@eval @msm' wdio run wdio.conf.ts",
    "test:e2e:eval-msm-longrun": "E2E_LIVE_LLM=1 E2E_GREP='@eval @msm @longrun' wdio run wdio.conf.ts",
    "dogfood:msm": "node --import tsx scripts/dogfood-msm-coding.mjs",
    "test:longrun-unit": "vitest run packages/sidecar/src/session/longrun-harness.test.ts packages/sidecar/src/session/goal-types.test.ts packages/sidecar/src/session/isolation.test.ts packages/sidecar/src/session/crash-recovery.test.ts",
    "test:longrun-gate": "bash scripts/hip-longrun-gate.sh",
    "test:e2e:knowledge": "E2E_GREP=@knowledge wdio run wdio.conf.ts",
    "test:e2e:knowledge-perf": "E2E_GREP=@knowledge-perf wdio run wdio.conf.ts",
    "test:e2e:knowledge-perf-strict": "KNOWLEDGE_PERF_STRICT=1 E2E_GREP=@knowledge-perf wdio run wdio.conf.ts",
    "test:e2e:work-items": "E2E_GREP=@work-items wdio run wdio.conf.ts",
    "test:e2e:voice": "HIP_VOICE_MOCK=1 E2E_GREP=@voice wdio run wdio.conf.ts",
    "cli:dev": "yarn workspace @hip/cli dev",
    "cli:build": "yarn workspace @hip/cli build",
    "cli:test": "yarn workspace @hip/cli test",
    "cli:type-check": "yarn workspace @hip/cli type-check",
    "product:content": "node scripts/generate-product-content.mjs && node scripts/generate-ops-content.mjs",
    "product:content:check": "node scripts/generate-product-content.mjs --check && node scripts/generate-ops-content.mjs --check",
    "prompt:dogfood": "node --import tsx scripts/product-prompt-dogfood.mjs",
    "prompt:dogfood:live": "DOGFOOD_LIVE=1 node --import tsx scripts/product-prompt-dogfood.mjs",
    "i18n:sync-zh-TW": "python3 scripts/sync-zh-TW-i18n.py",
    "check:store-deps": "node scripts/check-store-deps.mjs"
  },
  "dependencies": {
    "@blocknote/core": "0.52.1",
    "@blocknote/mantine": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@floating-ui/dom": "^1.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@hip/protocol": "*",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@radix-ui/react-context-menu": "^2.3.0",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-dropdown-menu": "^2",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-tabs": "^1",
    "@tanstack/react-virtual": "^3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-ligatures": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.18.0",
    "lucide-react": "^0.460",
    "mermaid": "^11.16.0",
    "minisearch": "^7.2.0",
    "nanoid": "^5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^9",
    "react-resizable-panels": "^2",
    "react-router-dom": "^6",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2",
    "zustand": "^5"
  },
  "resolutions": {
    "prosemirror-view": "1.42.2",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.0",
    "prosemirror-tables": "1.8.5",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-commands": "1.7.1",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-dropcursor": "1.8.3",
    "prosemirror-inputrules": "1.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.0.0",
    "@wdio/cli": "^9.27.2",
    "@wdio/local-runner": "^9.27.2",
    "@wdio/mocha-framework": "^9.27.2",
    "@wdio/spec-reporter": "^9.27.2",
    "@wdio/tauri-plugin": "^1.0.0",
    "@wdio/tauri-service": "^1.0.0",
    "autoprefixer": "^10",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3",
    "typescript": "~5.8.2",
    "vite": "^6.0.3",
    "vitest": "^2",
    "webdriverio": "^9.27.2"
  }
}
